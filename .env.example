# ---------------------------------------------------------------------------
# RelayCrew frontend configuration
# Copy this file to .env and replace the reference values for your own project.
# Every VITE_* value is public and is embedded in the browser bundle.
# ---------------------------------------------------------------------------

# "testnet" or "mainnet"
VITE_NETWORK_MODE=testnet

# Arc Testnet: 5042002 | Arc Mainnet: 5042
VITE_CHAIN_ID=5042002

VITE_RPC_URL=https://rpc.testnet.arc.io
VITE_EXPLORER_URL=https://explorer.testnet.arc.io
VITE_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# Reference Arc Testnet deployment. Replace this with YOUR deployed
# PipelineCoordinator before shipping a fork.
VITE_PIPELINE_CONTRACT_ADDRESS=0x7f9fc5bc88876e07e6674cd29bc73b9dbf02f070

# Replace with your own public repository URL. It is used by the footer link.
VITE_GITHUB_REPOSITORY_URL=https://github.com/onyebuchidaniel60/Relaycrew

# ---------------------------------------------------------------------------
# Local deployment only. Never commit this value, never expose it to Vite,
# never place it in Vercel, and never paste it into a browser or chat.
# ---------------------------------------------------------------------------
# DEPLOYER_PRIVATE_KEY=0x...
